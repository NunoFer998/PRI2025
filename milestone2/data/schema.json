{
  "add-field-type": [
    {
      "name": "text_symptom_boosted",
      "class": "solr.TextField",
      "positionIncrementGap": "100",
      
      "indexAnalyzer": {
        "tokenizer": {
          "class": "solr.PatternTokenizerFactory",
          "pattern": "[\\W_]+" 
        },
        "filters": [
          {
            "class": "solr.LowerCaseFilterFactory"
          },
          {
            "class": "solr.ASCIIFoldingFilterFactory"
          },
          {
            "class": "solr.SynonymGraphFilterFactory",
            "synonyms": "synonyms_diseases.txt",
            "ignoreCase": "true"
          },
          {
            "class": "solr.EnglishMinimalStemFilterFactory"
          }
        ]
      },
      
      "queryAnalyzer": {
        "tokenizer": {
          "class": "solr.PatternTokenizerFactory",
          "pattern": "[\\W_]+" 
        },
        "filters": [
          {
            "class": "solr.LowerCaseFilterFactory"
          },
          {
            "class": "solr.ASCIIFoldingFilterFactory"
          },
          {
            "class": "solr.SynonymGraphFilterFactory",
            "synonyms": "synonyms_diseases.txt",
            "ignoreCase": "true"
          },
          {
            "class": "solr.EnglishMinimalStemFilterFactory"
          }
        ]
      }
    }
  ],

  "add-field": [
    {
      "name": "name",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true
    },
    {
      "name": "symptoms",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true,
      "multiValued": true
    },
    {
      "name": "description",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true
    },
    {
      "name": "treatments",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true,
      "multiValued": true
    },
    {
      "name": "contagious",
      "type": "boolean",
      "stored": true,
      "indexed": true
    },
    {
      "name": "chronic",
      "type": "boolean",
      "stored": true,
      "indexed": true
    },
    {
      "name": "url",
      "type": "string",
      "stored": true,
      "indexed": false
    }
  ]
}
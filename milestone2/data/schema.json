{
  "add-field-type": {
    "name": "UnderscoreTextField",
    "class": "solr.TextField",
    "positionIncrementGap": "100",
    "indexAnalyzer": {
      "tokenizer": { "class": "solr.StandardTokenizerFactory" },
      "filters": [
        {
          "class": "solr.PatternReplaceFilterFactory",
          "pattern": "_",
          "replacement": " ",
          "replace": "all"
        },
        { "class": "solr.LowerCaseFilterFactory" }
      ]
    },
    "queryAnalyzer": {
      "tokenizer": { "class": "solr.StandardTokenizerFactory" },
      "filters": [
        {
          "class": "solr.PatternReplaceFilterFactory",
          "pattern": "_",
          "replacement": " ",
          "replace": "all"
        },
        { "class": "solr.LowerCaseFilterFactory" }
      ]
    }
  },

  "add-field": {
    "name": "name",
    "type": "UnderscoreTextField",
    "stored": true,
    "indexed": true 
  }

}

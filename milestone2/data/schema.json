{
  "add-field-type": [
    {
      "name": "text_symptom_boosted",
      "class": "solr.TextField",
      "positionIncrementGap": "100",
      "indexAnalyzer": {
        "tokenizer": {
          "class": "solr.PatternTokenizerFactory",
          "pattern": "[\\W_]+"
        },
        "filters": [
          { "class": "solr.LowerCaseFilterFactory" },
          { "class": "solr.ASCIIFoldingFilterFactory" },
          { "class": "solr.EnglishMinimalStemFilterFactory" }
        ]
      },
      "queryAnalyzer": {
        "tokenizer": {
          "class": "solr.PatternTokenizerFactory",
          "pattern": "[\\W_]+"
        },
        "filters": [
          { "class": "solr.LowerCaseFilterFactory" },
          { "class": "solr.ASCIIFoldingFilterFactory" },
          {
            "class": "solr.SynonymGraphFilterFactory",
            "synonyms": "synonyms_diseases.txt",
            "ignoreCase": "true"
          },
          { "class": "solr.EnglishMinimalStemFilterFactory" }
        ]
      }
    },
    {
      "name": "courseVector",
      "class": "solr.DenseVectorField",
      "vectorDimension": 384,
      "similarityFunction": "cosine",
      "knnAlgorithm": "hnsw"
    }

  ],
  "add-field": [
    {
      "name": "name",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true
    },
    {
      "name": "symptoms",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true,
      "multiValued": true
    },
    {
      "name": "description",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true
    },
    {
      "name": "treatments",
      "type": "text_symptom_boosted",
      "stored": true,
      "indexed": true,
      "multiValued": true
    },
    {
      "name": "contagious",
      "type": "boolean",
      "stored": true,
      "indexed": false
    },
    {
      "name": "chronic",
      "type": "boolean",
      "stored": true,
      "indexed": false
    },
    {
      "name": "url",
      "type": "string",
      "stored": true,
      "indexed": false
    },
    {
      "name": "vector",
      "type": "courseVector",
      "indexed": true,
      "stored": true
    }
  ]
}